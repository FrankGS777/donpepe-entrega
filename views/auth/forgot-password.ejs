<div class="auth-shell">
  <%- include('../partials/authBrand', {context: 'access'}) %>
  <main class="auth-stage">
    <section class="auth-card" aria-labelledby="forgotTitle">
      <%- include('../partials/authWordmark') %>
      <a class="auth-back" href="/login">← Volver al inicio de sesión</a>
      <div class="auth-card-head"><h1 id="forgotTitle">Recuperar contraseña</h1><p>Tras la aprobación, enviaremos un enlace de un solo uso al Gmail de recuperación registrado.</p></div>
      <%- include('../partials/errors') %>
      <form method="post" action="/cuenta/recuperar" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="auth-field"><label for="recoverEmail">Correo de acceso</label><div class="auth-input"><svg class="icon"><use href="/icons.svg#i-user"></use></svg><input id="recoverEmail" type="email" name="correo" autocomplete="username" value="<%= form?.correo||'' %>" placeholder="usuario@donpepe.pe" required></div></div>
        <button class="btn auth-primary" type="submit"><span>Enviar solicitud</span><span>→</span></button>
      </form>
    </section>
  </main>
</div>
