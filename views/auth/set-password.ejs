<div class="auth-shell">
  <%- include('../partials/authBrand', {context: 'access'}) %>
  <main class="auth-stage">
    <section class="auth-card" aria-labelledby="passwordTitle">
      <%- include('../partials/authWordmark') %>
      <div class="auth-card-head"><h1 id="passwordTitle">Define una nueva contraseña</h1><p><%= request.nombre %> · <%= request.correo %></p></div>
      <%- include('../partials/errors') %>
      <form method="post" action="/cuenta/activar/<%= token %>" class="auth-form" data-password-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="auth-field"><label for="newPassword">Nueva contraseña</label><div class="auth-input"><svg class="icon"><use href="/icons.svg#i-shield"></use></svg><input id="newPassword" type="password" name="password" minlength="10" maxlength="72" autocomplete="new-password" required><button type="button" data-toggle-password="newPassword">Mostrar</button></div><div class="password-rules" data-password-rules><span data-rule="length">10+ caracteres</span><span data-rule="upper">Mayúscula</span><span data-rule="lower">Minúscula</span><span data-rule="number">Número</span></div></div>
        <div class="auth-field"><label for="confirmPassword">Confirma la contraseña</label><div class="auth-input"><svg class="icon"><use href="/icons.svg#i-shield"></use></svg><input id="confirmPassword" type="password" name="confirmar_password" minlength="10" maxlength="72" autocomplete="new-password" required><button type="button" data-toggle-password="confirmPassword">Mostrar</button></div></div>
        <button class="btn auth-primary" type="submit">Guardar nueva contraseña</button>
      </form>
      <p class="auth-policy"><svg class="icon"><use href="/icons.svg#i-shield"></use></svg>El enlace es de un solo uso.</p>
    </section>
  </main>
</div>
