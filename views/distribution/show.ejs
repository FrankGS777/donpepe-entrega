<div class="commerce-page"><div class="page-head"><div><h1><%= order.sucursal %></h1><p><%= order.codigo %> · <%= order.direccion %></p></div><div class="d-flex gap-2"><a class="btn btn-outline-light" href="/wms/mapa?order=<%= order.id %>">Ver en la red 3D</a><a class="btn btn-outline-light" href="/wms/sucursales">Todos los pedidos</a></div></div>
<% const orderStep=['PENDIENTE','EN_PREPARACION','LISTO','DESPACHADO'].indexOf(order.estado); %>
<div class="distribution-flow" aria-label="Etapa del pedido"><% ['Pedido registrado','Preparación del equipo','Listo para cargar','Salida confirmada'].forEach((label,index)=>{ %><span class="<%= index<=orderStep?'active':'' %>"><b><%= index+1 %></b> · <%= label %></span><% if(index<3){ %><b aria-hidden="true">→</b><% } %><% }) %></div>
<section class="panel distribution-order-summary"><div><small>ESTADO</small><strong><%= order.estado.replaceAll('_',' ') %></strong></div><div><small>CREADO</small><strong><%= date(order.creado_en,true) %></strong></div><div><small>RESPONSABLE</small><strong><%= order.creador %></strong></div><div><small>DESPACHO</small><strong><%= date(order.despachado_en,true)||'Pendiente' %></strong></div></section>
<section class="panel"><div class="panel-title"><div><h2>LÍNEAS DEL PEDIDO</h2><small>Preparado significa trasladado y escaneado en staging, no entregado a la sucursal.</small></div></div><div class="distribution-lines"><% order.lines.forEach(line=>{ const pct=Math.min(100,Math.round(100*Number(line.preparada)/Number(line.cantidad_solicitada))); %><article><img src="<%= line.imagen_url||'/images/resource-fallback.svg' %>" alt="" loading="lazy"><span><small><%= line.sku %></small><strong><%= line.producto %></strong><em><%= line.preparada %> preparado · <%= line.en_tarea %> en RF · <%= line.cantidad_solicitada %> solicitado</em><i class="distribution-progress" style="--progress:<%= pct %>%"></i></span></article><% }) %></div></section>
<% if(['PENDIENTE','EN_PREPARACION'].includes(order.estado)&&can('distribution.plan')){ %><section class="panel distribution-action"><div><h2>Prepara y delega, en un paso.</h2><p>El sistema elige las existencias aptas y crea los movimientos del pedido. El operador confirma la preparación con su escáner.</p></div><form method="post" action="/wms/sucursales/<%= order.id %>/planificar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(can('wms.tasks.assign')){ %><label>Responsable de la preparación<select name="operador_id" class="form-select"><option value="">Asignar después, desde el tablero</option><% (typeof operators!=='undefined'?operators:[]).forEach(operator=>{ %><option value="<%= operator.id %>"><%= operator.nombre %></option><% }) %></select></label><% } %><button class="btn btn-brand">Preparar pedido</button></form><a href="/wms/tareas/nueva" class="btn btn-outline-warning">Reponer mercancía</a><small class="field-help">Si no alcanza el stock del área de preparación, repón y vuelve a este pedido.</small></section><% } %>
<% if(order.estado==='LISTO'&&can('distribution.dispatch')){ %><section class="panel distribution-action"><div><h2>CONFIRMAR SALIDA DEL CD</h2><p>Verifica carga física, referencia de guía y vehículo. Esta referencia interna no sustituye la emisión legal de una guía electrónica.</p></div><form method="post" action="/wms/sucursales/<%= order.id %>/despachar" class="distribution-dispatch-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Referencia de guía<input class="form-control" name="referencia_guia" required minlength="4" maxlength="40" placeholder="GUIA-2026-001"></label><label>Placa del vehículo<input class="form-control" name="placa_vehiculo" required minlength="5" maxlength="12" placeholder="ABC-123"></label><button class="btn btn-brand" data-confirm="¿Confirmas que la carga salió físicamente del CD?">Confirmar despacho</button></form></section><% } %>
<% if(order.estado==='DESPACHADO'){ %><section class="panel"><strong>La carga salió del centro</strong><p>Guía referencial: <%= order.referencia_guia %> · vehículo <%= order.placa_vehiculo %>. La animación del mapa no acredita recepción en tienda.</p><a class="ops-button primary" href="/wms/mapa?order=<%= order.id %>">Explorar recorrido 3D →</a></section><% } %>
<% if(order.estado==='DESPACHADO'){ const returnable=order.tasks.filter(task=>task.estado==='COMPLETADA'&&Number(task.retornable)>0); %>
<section class="panel"><div class="panel-title"><div><h2>DEVOLUCIONES DE SUCURSAL</h2><small>Registra únicamente mercancía físicamente devuelta de este pedido. Entra bloqueada a recepción y RF la lleva a cuarentena térmicamente compatible.</small></div></div>
  <% if(can('distribution.return')&&returnable.length){ %><form method="post" action="/wms/sucursales/<%= order.id %>/devolver" class="distribution-dispatch-form distribution-return-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Expedición y lote<select class="form-select" name="tarea_picking_id" required><option value="">Selecciona una línea despachada</option><% returnable.forEach(task=>{ %><option value="<%= task.id %>"><%= task.sku %> · <%= task.numero_lote %> · máximo <%= task.retornable %> UND</option><% }) %></select></label><label>Cantidad devuelta<input class="form-control" type="number" name="cantidad" min="1" max="100000" required></label><label>Motivo<select class="form-select" name="motivo" required><option value="RECHAZO">Rechazo de sucursal</option><option value="DANIO">Daño</option><option value="SOBRANTE">Excedente de ruta</option></select></label><button class="btn btn-outline-warning" data-confirm="¿Confirmas que estas unidades llegaron físicamente al CD?">Registrar retorno</button></form><% } else if(!returnable.length){ %><p>Este pedido no tiene más unidades retornables.</p><% } %>
  <% if(order.returns.length){ %><div class="distribution-task-list"><% order.returns.forEach(item=>{ %><article><span class="sku-chip">RET-<%= item.id %></span><strong><%= item.sku %> · <%= item.numero_lote_original %></strong><small><%= item.cantidad %> UND · <%= item.motivo %> · <%= date(item.registrado_en,true) %></small><span class="status-pill <%= item.estado_tarea==='COMPLETADA'?'ok':'pending' %>"><%= item.estado_tarea.replaceAll('_',' ') %></span><small>Unidad logística <%= item.lote_retorno %> · RF <%= item.codigo_tarea %></small></article><% }) %></div><% } %>
</section><% } %>
<details class="ops-zone-details"><summary>Ver tareas y ubicaciones exactas</summary><section class="panel"><div class="panel-title"><h2>Preparación de este pedido</h2><a href="/wms/tareas" class="btn btn-outline-warning">Tablero del equipo</a></div><% if(!order.tasks.length){ %><div class="empty">Las tareas aparecerán al preparar el pedido.</div><% } else { %><div class="distribution-task-list"><% order.tasks.forEach(task=>{ %><article><span class="sku-chip"><%= task.codigo_tarea %></span><strong><%= task.sku %> · <%= task.numero_lote %></strong><small><%= task.loc_origen %> → <%= task.loc_destino %> · <%= task.cantidad %> UND</small><span class="status-pill <%= task.estado==='COMPLETADA'?'ok':task.estado==='EN_PROCESO'?'pending':'off' %>"><%= task.estado.replaceAll('_',' ') %></span><small><%= task.operador||'Sin asignar' %></small></article><% }) %></div><% } %></section></details>
</div>
