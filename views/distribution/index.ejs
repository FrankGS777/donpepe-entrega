<div class="commerce-page"><div class="page-head"><div><h1><%= can('distribution.create')?'Pedidos de tus sucursales':'Seguimiento de distribución' %></h1><p>Abre un pedido para preparar, asignar al equipo o confirmar su salida.</p></div><% if(can('distribution.create')){ %><a class="btn btn-brand" href="/wms/sucursales/nuevo">＋ Nuevo pedido</a><% } %></div>
<section class="ops-pipeline" aria-label="Pedidos por etapa"><% [['PENDIENTE','Por preparar'],['EN_PREPARACION','En preparación'],['LISTO','Listos para cargar']].forEach(([state,label],index)=>{ %><div class="ops-stage"><span><svg class="icon"><use href="/icons.svg#i-truck"/></svg></span><div><strong><%= orders.filter(o=>o.estado===state).length %></strong><small><%= label %></small></div></div><% }) %></section>
<section class="panel"><div class="panel-title"><div><h2>Pedidos</h2><small>Productos de cualquier proveedor, agrupados por destino.</small></div><span class="badge text-bg-warning"><%= orders.length %> pedidos</span></div>
  <% if(!orders.length){ %><div class="empty">Aún no hay pedidos de sucursales.</div><% } else { %>
  <div class="distribution-orders"><% orders.forEach(order=>{ %><a class="distribution-order" href="/wms/sucursales/<%= order.id %>"><span><small><%= order.codigo %> · <%= date(order.creado_en,true) %></small><strong><%= order.sucursal %></strong><em><%= order.lineas %> SKU · <%= order.unidades %> UND</em></span><span class="status-pill <%= order.estado==='DESPACHADO'?'ok':order.estado==='LISTO'?'pending':'off' %>"><%= order.estado.replaceAll('_',' ') %></span><small><%= order.tareas_abiertas %> tareas abiertas →</small></a><% }) %></div>
  <% } %>
</section>
<section class="panel distribution-branches"><div class="panel-title"><div><h2>DESTINOS CONFIGURADOS</h2><small>Las sucursales son destinos, no LOC dentro del almacén.</small></div></div><div class="distribution-branch-grid"><% branches.forEach(branch=>{ %><article><b><%= branch.codigo %></b><strong><%= branch.nombre %></strong><small><%= branch.direccion %></small><span><%= branch.pedidos %> pedidos · <%= branch.activo?'Activa':'Inactiva' %></span></article><% }) %></div>
  <% if(can('distribution.branches.manage')){ %><details class="advanced-fields mt-3"><summary>Registrar otra sucursal</summary><form class="row g-3 mt-2" method="post" action="/wms/sucursales/maestro"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="col-md-2"><label class="form-label">Código</label><input class="form-control" name="codigo" maxlength="15" required placeholder="DP-NORTE"></div><div class="col-md-4"><label class="form-label">Nombre</label><input class="form-control" name="nombre" maxlength="100" required placeholder="Don Pepe Norte"></div><div class="col-md-4"><label class="form-label">Dirección real</label><input class="form-control" name="direccion" maxlength="180" required placeholder="Dirección de entrega"></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-brand w-100">Guardar</button></div></form></details><% } %>
</section>
</div>
