<div class="page-head"><div><h1><%= can('purchases.create')?'ÓRDENES DE COMPRA':'MERCADERÍA POR RECIBIR' %></h1><p><%= can('purchases.create')?'Planifica y sigue cada orden hasta su recepción.':'Confirma el ingreso físico de las órdenes pendientes.' %></p></div><% if(can('purchases.create')){ %><a class="btn btn-brand" href="/compras/nueva">+ Nueva orden</a><% } %></div>
<div class="panel">
  <form class="list-toolbar row g-2 mb-4"><div class="col-lg-6"><label class="visually-hidden" for="purchaseSearch">Buscar</label><input id="purchaseSearch" class="form-control" name="q" value="<%= filters.q||'' %>" placeholder="Código de orden o proveedor..."></div><div class="col-lg-3"><label class="visually-hidden" for="purchaseStatus">Estado</label><select id="purchaseStatus" class="form-select" name="status"><option value="">Todos los estados</option><% ['PENDIENTE','PARCIAL','RECIBIDA','CANCELADA'].forEach(state=>{ %><option value="<%= state %>" <%= filters.status===state?'selected':'' %>><%= state %></option><% }) %></select></div><div class="col-lg-3 d-flex gap-2"><button class="btn btn-outline-light flex-grow-1">Filtrar</button><a class="btn btn-outline-secondary" href="/compras" aria-label="Limpiar filtros">×</a></div></form>
  <div class="panel-title"><div><h2>COLA DE ABASTECIMIENTO</h2><small>Las órdenes pendientes y parciales admiten nuevas entregas.</small></div><span class="badge text-bg-warning"><%= orders.length %> órdenes</span></div>
  <% if(!orders.length){ %><div class="empty"><strong>No hay órdenes con este filtro.</strong><small>Prueba otro proveedor o estado.</small></div><% } else { %><div class="table-responsive"><table class="table table-darkish"><thead><tr><th>Orden</th><th>Proveedor</th><th>Emisión</th><th>Estado</th><th>Total estimado</th><th></th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><strong><%= o.codigo_orden %></strong><small>Creada por <%= o.usuario %></small></td><td><%= o.proveedor %></td><td><%= date(o.fecha_emision,true) %></td><td><span class="status-pill <%= o.estado==='RECIBIDA'?'ok':o.estado==='CANCELADA'?'off':'pending' %>"><%= o.estado %></span></td><td><%= money(o.total_estimado) %></td><td><a class="btn btn-sm btn-outline-warning" href="/compras/<%= o.id %>"><%= can('purchases.receive')&&['PENDIENTE','PARCIAL'].includes(o.estado)?'Procesar':'Ver detalle' %></a></td></tr><% }) %></tbody></table></div><% } %>
</div>
