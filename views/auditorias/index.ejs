<div class="page-head">
  <div><h1><%= can('audits.approve')?'Aprobación de ajustes':'Conteos y diferencias' %></h1><p><%= can('audits.approve')?'Revisa la evidencia antes de aprobar o rechazar diferencias de inventario.':'Registra conteos por SKU, lote y LOC. Las diferencias requieren aprobación del administrador.' %></p></div>
  <% if(can('audits.create')){ %><a class="btn btn-brand" href="/auditorias/nueva">+ Nuevo conteo</a><% } %>
</div>
<form class="list-toolbar row g-2 mb-3"><div class="col-md-5"><label class="visually-hidden" for="auditStatus">Estado</label><select id="auditStatus" class="form-select" name="status"><option value="">Todos los conteos</option><option value="PENDIENTE" <%= filters.status==='PENDIENTE'?'selected':'' %>>Pendientes de revisión</option><option value="APROBADA" <%= filters.status==='APROBADA'?'selected':'' %>>Aprobados</option><option value="RECHAZADA" <%= filters.status==='RECHAZADA'?'selected':'' %>>Rechazados</option></select></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-light flex-grow-1">Aplicar filtro</button><a class="btn btn-outline-secondary" href="/auditorias" aria-label="Limpiar filtros">×</a></div></form>
<div class="panel"><div class="table-responsive"><table class="table table-darkish align-middle">
  <thead><tr><th>Conteo</th><th>Posición WMS</th><th>Sistema → físico</th><th>Ajuste</th><th>Estado y revisión</th><th></th></tr></thead>
  <tbody><% if(!audits.length){ %><tr><td colspan="6"><div class="empty">No hay conteos con este estado.</div></td></tr><% } %><% audits.forEach(a=>{ %><tr>
    <td><strong>#<%= a.id %></strong><small><%= date(a.fecha_auditoria,true) %></small><small>Por <%= a.usuario %></small></td>
    <td><span class="sku-chip"><%= a.sku %></span><strong><%= a.producto %></strong><small>Lote: <%= a.codigo_lote||'Conteo anterior sin lote' %></small><small><span class="loc-code d-inline"><%= a.codigo_loc||'CONTEO LEGACY' %></span><%= a.zona?' · '+a.zona+' · '+a.pasillo+'/'+a.estante:'' %></small><small><%= a.observaciones||'Sin observaciones' %></small></td>
    <td><%= a.stock_sistema %> → <%= a.stock_fisico %><strong class="d-block <%= a.diferencia===0?'text-success':'text-warning' %>"><%= a.diferencia>0?'+':'' %><%= a.diferencia %></strong></td>
    <td><%= a.tipo_ajuste.replaceAll('_',' ') %><% if(a.fecha_vencimiento_ajuste){ %><small>Vence: <%= date(a.fecha_vencimiento_ajuste) %></small><% } %></td>
    <td><span class="status-pill <%= a.estado==='APROBADA'?'ok':a.estado==='RECHAZADA'?'off':'pending' %>"><%= a.estado %></span><% if(a.aprobador){ %><small><%= a.aprobador %> · <%= date(a.aprobado_en,true) %></small><% } %></td>
    <td><% if(a.estado==='PENDIENTE'&&can('audits.approve')&&Number(a.usuario_id)!==Number(currentUser.id)){ %><div class="d-flex gap-2"><form method="post" action="/auditorias/<%= a.id %>/aprobar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-brand" data-confirm="¿Aprobar este ajuste en la LOC indicada?">Aprobar</button></form><form method="post" action="/auditorias/<%= a.id %>/rechazar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger" data-confirm="¿Rechazar sin modificar inventario?">Rechazar</button></form></div><% } else if(a.estado==='PENDIENTE'&&can('audits.approve')) { %><small class="text-warning">Requiere otro responsable</small><% } %></td>
  </tr><% }) %></tbody>
</table></div></div>
