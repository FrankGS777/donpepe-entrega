<% if(flash) { const failed=['error','danger'].includes(flash.type); %><div class="alert alert-<%= failed?'danger':flash.type %> action-feedback" role="<%= failed?'alert':'status' %>"><svg class="icon feedback-symbol" aria-hidden="true"><use href="/icons.svg#<%= failed?'i-alert':flash.type==='success'?'i-check':'i-bell' %>"/></svg><span><%= flash.message %></span><button type="button" class="btn-close" data-ui-dismiss="alert" aria-label="Cerrar"></button></div><% } %>
