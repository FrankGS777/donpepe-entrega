<header class="topbar shellbar">
  <div class="shellbar-leading"><button class="shell-icon-button d-lg-none" id="menuToggle" aria-label="Abrir menú"><span class="menu-lines" aria-hidden="true"></span></button><a class="shell-home d-lg-none" href="<%= homePath %>"><%- include('brandLogo') %></a><div class="shell-context"><span><%= currentUser.rol==='administrador_wms'?'CONTROL WMS':'OPERACIÓN EN VIVO' %></span><strong><%= shellContext.page %></strong></div></div>
  <div class="shellbar-actions">
    <span class="peru-clock d-none d-md-inline" data-peru-clock></span><span class="role-chip d-none d-md-inline-flex"><i></i><%= currentUser.rol_etiqueta||currentUser.rol.replaceAll('_',' ') %></span>
    <% if(can('requests.manage')){ %><div class="ui-menu"><button class="shell-icon-button notification-button" data-ui-menu-button aria-expanded="false" aria-label="Solicitudes de recuperación"><svg class="icon"><use href="/icons.svg#i-bell"></use></svg><% if(pendingRequestCount){ %><span><%= pendingRequestCount>99?'99+':pendingRequestCount %></span><% } %></button><div class="dropdown-menu shell-notifications" data-ui-menu-panel hidden><div class="notification-head"><div><strong>Recuperación</strong><small><%= pendingRequestCount %> pendientes</small></div><a href="/solicitudes">Abrir</a></div><% if(!pendingRequests.length){ %><div class="notification-empty"><svg class="icon"><use href="/icons.svg#i-shield"></use></svg><span>Sin solicitudes</span></div><% } %><% pendingRequests.forEach(item=>{ %><a class="notification-item" href="/solicitudes?status=PENDIENTE"><span>R</span><div><strong><%= item.nombre||'Usuario registrado' %></strong><small><%= date(item.creado_en,true) %></small></div></a><% }) %></div></div><% } %>
    <div class="ui-menu"><button class="shell-profile" aria-label="Abrir menú de mi cuenta" data-ui-menu-button aria-expanded="false"><span class="avatar"><%= currentUser.nombre.charAt(0) %></span><span class="d-none d-sm-flex"><strong><%= currentUser.nombre %></strong><small><%= currentUser.rol_etiqueta||currentUser.rol.replaceAll('_',' ') %></small></span><b aria-hidden="true">⌄</b></button><div class="dropdown-menu profile-menu" data-ui-menu-panel hidden><div class="profile-menu-head"><span class="avatar"><%= currentUser.nombre.charAt(0) %></span><div><strong><%= currentUser.nombre %></strong><small><%= currentUser.correo %></small></div></div><a href="<%= homePath %>"><svg class="icon"><use href="/icons.svg#i-grid"></use></svg>Inicio</a><a href="/mi-cuenta"><svg class="icon"><use href="/icons.svg#i-user"></use></svg>Mi cuenta</a><a href="/mi-clave"><svg class="icon"><use href="/icons.svg#i-shield"></use></svg>Mi clave</a><% if(can('users.view')){ %><a href="/usuarios"><svg class="icon"><use href="/icons.svg#i-users"></use></svg>Usuarios</a><% } %><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button><svg class="icon"><use href="/icons.svg#i-logout"></use></svg>Cerrar sesión</button></form></div></div>
  </div>
</header>
