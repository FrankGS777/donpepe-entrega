<div class="page-head"><div><h1>MOVIMIENTOS</h1><p>Kardex de entradas, salidas y traslados entre LOC.</p></div></div>
<div class="panel">
  <form class="list-toolbar row g-2 mb-4"><div class="col-lg-7"><label class="visually-hidden" for="movementSearch">Buscar</label><input id="movementSearch" class="form-control" name="q" value="<%= filters.q||'' %>" placeholder="SKU, producto, lote o motivo..."></div><div class="col-lg-3"><label class="visually-hidden" for="movementType">Tipo</label><select id="movementType" class="form-select" name="type"><option value="">Entradas y salidas</option><option value="ENTRADA" <%= filters.type==='ENTRADA'?'selected':'' %>>Solo entradas</option><option value="SALIDA" <%= filters.type==='SALIDA'?'selected':'' %>>Solo salidas</option></select></div><div class="col-lg-2 d-flex gap-2"><button class="btn btn-outline-light flex-grow-1">Filtrar</button><a class="btn btn-outline-secondary" href="/inventario/movimientos" aria-label="Limpiar filtros">×</a></div></form>
  <div class="panel-title"><div><h2>HISTORIAL INMUTABLE</h2><small>Máximo 300 eventos recientes según el filtro.</small></div><span class="badge text-bg-warning"><%= movements.length %> eventos</span></div>
  <% if(!movements.length){ %><div class="empty"><strong>No hay movimientos con este filtro.</strong><small>Prueba otro SKU o incluye ambos tipos.</small></div><% } else { %><div class="table-responsive"><table class="table table-darkish"><thead><tr><th>Fecha</th><th>Tipo</th><th>SKU / producto</th><th>LOC / lote</th><th>Cantidad</th><th>Referencia</th><th>Usuario</th></tr></thead><tbody><% movements.forEach(m=>{ %><tr><td><%= date(m.creado_en,true) %></td><td><span class="badge <%= m.tipo_movimiento==='ENTRADA'?'text-bg-success':'text-bg-danger' %>"><%= m.tipo_movimiento %></span></td><td><span class="sku-chip"><%= m.sku %></span><strong><%= m.producto %></strong></td><td><strong class="loc-code"><%= m.codigo_loc||'SIN LOC' %></strong><small>Lote <%= m.numero_lote||'—' %></small></td><td><%= m.cantidad %></td><td><%= m.referencia_tipo||'—' %> <%= m.referencia_id?'#'+m.referencia_id:'' %><small><%= m.motivo||'Sin motivo registrado' %></small></td><td><%= m.usuario %></td></tr><% }) %></tbody></table></div><% } %>
</div>
