<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %> · <%= storeName %></title><%- include('../partials/brandIcons') %><meta name="theme-color" content="#4b1f6f">
<link rel="stylesheet" href="/css/tokens.css"><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/ui.css"><% if(currentPath==='/wms/mapa'){ %><link rel="stylesheet" href="/css/warehouse-map.css"><% } %><link rel="stylesheet" href="/css/lumen.css"><link rel="stylesheet" href="/css/role-access.css"><link rel="stylesheet" href="/css/brand.css"><link rel="stylesheet" href="/css/control-center.css"><% if(currentPath==='/wms/mapa'||(currentPath==='/dashboard'&&currentUser.perfil==='jefe_operaciones')){ %><link rel="stylesheet" href="/css/logistics-scene.css"><% } %><% if(currentPath.startsWith('/wms/tareas')){ %><link rel="stylesheet" href="/css/task-planning.css"><% } %></head>
<body class="role-<%= currentUser.perfil||currentUser.rol %>" data-screen="<%= currentPath %>" data-user-id="<%= currentUser.id %>"><div class="app-shell"><%- include('../partials/sidebar') %><main class="main-content"><%- include('../partials/topbar') %><div class="container-fluid p-3 p-lg-4">
<%- include('../partials/flash') %><%- body %><%- include('../partials/contextHelp') %></div></main></div>
<script src="/js/ui.js"></script><script src="/vendor/zxing/zxing-browser.min.js"></script><script src="/js/scanner.js"></script><script src="/js/app.js"></script><script src="/js/commerce-flow.js"></script><% if(currentPath==='/compras/nueva'){ %><script src="/js/purchase.js"></script><% } %><% if(/^\/(?:compras\/\d+\/recibir|rf\/recepcion\/\d+)$/.test(currentPath)){ %><script src="/js/receive.js"></script><% } %><% if(currentPath==='/wms/tareas/nueva'){ %><script src="/js/wms-task.js"></script><% } %><% if(currentPath==='/wms/mapa'){ %><script src="/js/warehouse-map.js"></script><% } %><% if(currentPath==='/wms/mapa'||(currentPath==='/dashboard'&&currentUser.perfil==='jefe_operaciones'&&can('wms.positions'))){ %><script src="/js/logistics-network.js"></script><% } %><% if(/^\/catalogos\/ubicaciones\/(nuevo|\d+\/editar)$/.test(currentPath)){ %><script src="/js/location-form.js"></script><% } %><% if(currentPath==='/auditorias/nueva'){ %><script src="/js/audit-form.js"></script><% } %><% if(currentPath==='/wms/etiquetas'){ %><script src="/js/labels.js"></script><% } %></body></html>
