<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title><%= title %> · RF <%= storeName %></title><%- include('../partials/brandIcons') %><meta name="theme-color" content="#4b1f6f"><link rel="stylesheet" href="/css/tokens.css"><link rel="stylesheet" href="/css/app.css"><link rel="stylesheet" href="/css/ui.css"><link rel="stylesheet" href="/css/lumen.css"><link rel="stylesheet" href="/css/role-access.css"><link rel="stylesheet" href="/css/brand.css"><link rel="stylesheet" href="/css/rf-experience.css"></head>
<body class="rf-mode rf-experience"><header class="rf-top"><a class="rf-brand" href="/rf" aria-label="DonPepe · Mi estación"><%- include('../partials/brandLogo') %><small><%= currentUser.rol_etiqueta||'Operador RF' %></small></a><a class="rf-scan-link" href="/rf/scanner"><svg class="icon"><use href="/icons.svg#i-camera"/></svg><span>Escanear</span></a></header>
<main class="rf-content"><%- include('../partials/flash') %><%- body %></main>
<footer class="rf-footer"><a href="/rf" class="<%= currentPath==='/rf'?'active':'' %>"><svg class="icon"><use href="/icons.svg#i-grid"/></svg><span>Inicio</span></a><% if(can('rf.checkin')){ %><a href="/rf/check-in" class="<%= currentPath==='/rf/check-in'?'active':'' %>"><svg class="icon"><use href="/icons.svg#i-pin"/></svg><span>Ubicar</span></a><% } %><% if(can('rf.pick')){ %><a href="/rf/picking" class="<%= currentPath==='/rf/picking'?'active':'' %>"><svg class="icon"><use href="/icons.svg#i-package"/></svg><span>Preparar</span></a><% } %><% if(can('rf.transfer')){ %><a href="/rf/transfer" class="<%= currentPath==='/rf/transfer'?'active':'' %>"><svg class="icon"><use href="/icons.svg#i-arrows"/></svg><span>Mover</span></a><% } %><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button><svg class="icon"><use href="/icons.svg#i-logout"/></svg><span>Salir</span></button></form></footer>
<script src="/js/ui.js"></script><script src="/vendor/zxing/zxing-browser.min.js"></script><script src="/js/scanner.js"></script><script src="/js/app.js"></script><% if(/^\/rf\/recepcion\/\d+$/.test(currentPath)){ %><script src="/js/receive.js"></script><% } %><script src="/js/rf.js"></script></body></html>
