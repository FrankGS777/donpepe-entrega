<% const operational=typeof network==='object'&&network?network:{orders:[],purchases:[],tasks:[],stats:{}};
const waitingOrders=operational.orders.filter(o=>o.estado==='PENDIENTE');
const readyOrders=operational.orders.filter(o=>o.estado==='LISTO');
const activeOrders=operational.orders.filter(o=>o.estado==='EN_PREPARACION');
const unassigned=operational.tasks.filter(t=>!t.asignado);
const taskNames={PUTAWAY:'Ubicar mercancía',PICKING:'Preparar pedido',REABASTECIMIENTO:'Reponer preparación',REUBICACION:'Reubicar mercancía',DEVOLUCION_RUTA:'Aislar devolución'};
const next=readyOrders.length?{title:'Una salida está lista',text:'Revisa la carga y confirma su salida del centro.',href:'/wms/sucursales/'+readyOrders[0].id,label:'Revisar despacho'}:unassigned.length?{title:'El equipo tiene trabajo por recibir',text:'Asigna las tareas pendientes a un operador.',href:'/wms/tareas?status=PENDIENTE',label:'Asignar trabajo'}:waitingOrders.length?{title:'Hay pedidos por preparar',text:'Abre el pedido. El sistema localizará sus existencias.',href:'/wms/sucursales/'+waitingOrders[0].id,label:'Preparar pedido'}:{title:'Planifica el siguiente movimiento',text:'Solicita mercancía para una sucursal o repón la zona de preparación.',href:'/wms/sucursales/nuevo',label:'Nuevo pedido'}; %>
<div class="operations-home">
  <header class="ops-heading"><div><span class="ops-kicker">DONPEPE · OPERACIONES</span><h1>Tu centro de distribución</h1></div><div class="ops-heading-actions"><a class="ops-button subtle" href="/wms/tareas">Ver trabajo del equipo</a><% if(can('distribution.create')){ %><a class="ops-button primary" href="/wms/sucursales/nuevo">＋ Pedido de sucursal</a><% } %></div></header>
  <% if(can('wms.positions')){ %><%- include('../partials/logisticsScene',{sceneVariant:'dashboard'}) %><% } %>
  <section class="ops-workspace" aria-label="Acciones de operaciones">
    <article class="ops-next"><span class="ops-next-icon"><svg class="icon"><use href="/icons.svg#i-arrows"/></svg></span><div><small>SIGUIENTE ACCIÓN</small><h2><%= next.title %></h2><p><%= next.text %></p></div><a class="ops-button primary" href="<%= next.href %>"><%= next.label %> →</a></article>
    <div class="ops-shortcuts"><a href="/wms/tareas/nueva"><span class="ops-shortcut-icon"><svg class="icon"><use href="/icons.svg#i-package"/></svg></span><div><strong>Mover mercancía</strong><small>Producto → sugerencia → operador</small></div><span aria-hidden="true">↗</span></a><a href="/wms/mapa?view=interior"><span class="ops-shortcut-icon gold"><svg class="icon"><use href="/icons.svg#i-pin"/></svg></span><div><strong>Entrar al almacén</strong><small>Explora zonas, estantes y cargas</small></div><span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="ops-pipeline" aria-label="Pedidos en cada etapa"><% [{name:'Por preparar',count:operational.stats.pendingOrders??waitingOrders.length,icon:'i-clipboard',tone:'purple'},{name:'En preparación',count:operational.stats.inPreparationOrders??activeOrders.length,icon:'i-package',tone:'gold'},{name:'Listos para salir',count:operational.stats.readyOrders??readyOrders.length,icon:'i-truck',tone:'green'}].forEach((stage,i)=>{ %><a href="/wms/sucursales" class="ops-stage <%= stage.tone %>"><span><b><%= i+1 %></b><svg class="icon"><use href="/icons.svg#<%= stage.icon %>"/></svg></span><div><strong><%= stage.count %></strong><small><%= stage.name %></small></div><span aria-hidden="true">→</span></a><% }) %></section>
  <div class="ops-lower-grid">
    <section class="ops-panel"><div class="ops-panel-head"><h2>Trabajo del equipo</h2><a href="/wms/tareas">Abrir tablero →</a></div><% if(!operational.tasks.length){ %><div class="ops-empty"><strong>No hay movimientos pendientes</strong><p>Los ingresos y pedidos aparecerán aquí cuando generen trabajo.</p></div><% } %><div class="ops-work-list"><% operational.tasks.slice(0,5).forEach(t=>{ %><a href="/wms/tareas?status=<%= t.estado %>" class="ops-work-item"><span class="ops-work-state <%= t.estado==='EN_PROCESO'?'running':'' %>"><svg class="icon"><use href="/icons.svg#<%= t.tipo==='PICKING'?'i-package':'i-arrows' %>"/></svg></span><div><small><%= taskNames[t.tipo]||t.tipo %></small><strong><%= t.producto %></strong><span><%= t.origen %> → <%= t.destino %> · <%= t.cantidad %> un.</span></div><em><%= t.asignado||'Por asignar' %></em></a><% }) %></div></section>
    <section class="ops-panel"><div class="ops-panel-head"><h2>Necesita tu atención</h2><span class="ops-count"><%= data.critical.length+data.expiring.length %></span></div><% if(!data.critical.length&&!data.expiring.length){ %><div class="ops-empty"><strong>Sin alertas de stock o vencimiento</strong><p>Revisa los conteos y pedidos para continuar el turno.</p></div><% } %><% data.critical.slice(0,3).forEach(p=>{ %><a class="ops-alert-item" href="/productos"><span class="ops-alert-dot"></span><div><strong><%= p.nombre %></strong><small><%= p.stock_total %> en sistema · mínimo <%= p.stock_minimo %></small></div><b>Stock bajo</b></a><% }) %><% data.expiring.slice(0,3).forEach(l=>{ %><a class="ops-alert-item" href="/inventario/lotes"><span class="ops-alert-dot warning"></span><div><strong><%= l.producto||l.nombre %></strong><small>Lote <%= l.numero_lote %> · <%= l.cantidad_actual %> unidades</small></div><b><%= Number(l.dias)<0?'Vencido':Number(l.dias)===0?'Vence hoy':l.dias+' días' %></b></a><% }) %></section>
  </div>
  <details class="ops-zone-details"><summary>Capacidad de las zonas <span><%= wms.zones.length %> áreas · ver detalle</span></summary><div class="ops-zone-grid"><% wms.zones.forEach(z=>{ %><a href="/wms/posiciones?zone=<%= encodeURIComponent(z.codigo_zona) %>"><strong><%= z.zona %></strong><small><%= z.ocupadas %> / <%= z.capacidad %> posiciones ocupadas</small><progress max="100" value="<%= Math.min(100,Number(z.ocupacion)||0) %>"><%= z.ocupacion %>%</progress></a><% }) %></div></details>
</div>
