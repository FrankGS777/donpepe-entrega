<div class="page-head"><div><h1>CAMBIAR MI CONTRASEÑA</h1><p>Confirma tu clave actual antes de elegir una nueva.</p></div><a class="btn btn-outline-light" href="<%= homePath %>">Volver</a></div>
<section class="panel form-panel account-password-panel">
  <%- include('../partials/errors') %>
  <form method="post" action="/mi-clave" data-password-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="account-password-fields">
      <div><label class="form-label" for="currentPassword">Contraseña actual</label><input class="form-control" id="currentPassword" name="password_actual" type="password" autocomplete="current-password" required></div>
      <div><label class="form-label" for="newPassword">Nueva contraseña</label><input class="form-control" id="newPassword" name="password" type="password" autocomplete="new-password" minlength="10" maxlength="72" required><small class="field-help">10 o más caracteres; mayúscula, minúscula y número. No puede ser igual a la actual ni a las cinco anteriores.</small></div>
      <div><label class="form-label" for="confirmPassword">Confirmar nueva contraseña</label><input class="form-control" id="confirmPassword" name="confirmar_password" type="password" autocomplete="new-password" minlength="10" maxlength="72" required></div>
    </div>
    <div class="form-actions"><button class="btn btn-brand" type="submit">Actualizar contraseña</button></div>
  </form>
</section>
