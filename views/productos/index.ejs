<div class="page-head"><div><h1>SKU Y PRODUCTOS</h1><p>Catálogo, estrategia de picking y disponibilidad.</p></div><% if(can('products.create')){ %><a class="btn btn-brand" href="/productos/nuevo"><svg class="icon"><use href="/icons.svg#i-plus"/></svg> Nuevo SKU</a><% } %></div>
<div class="panel"><form class="row g-2 mb-4"><div class="col-md-6"><input class="form-control" name="q" value="<%= filters.q||'' %>" placeholder="Buscar SKU, descripción o código de barras..."></div><div class="col-md-3"><select data-native-select="true" class="form-select" name="active"><option value="">Todos</option><option value="1" <%= filters.active==='1'?'selected':'' %>>Activos</option><option value="0" <%= filters.active==='0'?'selected':'' %>>Inactivos</option></select></div><div class="col-md-3"><button class="btn btn-outline-light w-100">Buscar</button></div></form>
<div class="table-responsive"><table class="table table-darkish align-middle"><thead><tr><th>SKU</th><th>Clasificación</th><th>Estrategia LOC</th><th>Dimensiones</th><th>Stock</th><th>Estado</th><th></th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="product-master-identity"><img src="<%= p.imagen_url||'/images/resource-fallback.svg' %>" alt="" loading="lazy" referrerpolicy="no-referrer"><span><b class="sku-chip"><%= p.sku %></b><strong><%= p.nombre %></strong><small>#<%= p.id %> · EAN <%= p.codigo_barras||'sin código' %></small><% if(p.referencia_url){ %><a href="<%= p.referencia_url %>" target="_blank" rel="noopener noreferrer">Ver presentación ↗</a><% } %></span></div></td><td><%= p.categoria %> · <%= p.marca %><small>Rotación ABC: <%= p.clase_abc||'B' %></small><% if(can('products.update')){ %><small><%= p.proveedor||'Sin proveedor sugerido' %></small><small><%= p.unidad_medida %> · Costo <%= money(p.precio_compra) %> · PVP ref. <%= money(p.precio_venta) %></small><% } else { %><small>Unidad base: <%= p.unidad_medida %></small><% } %></td><td><strong class="loc-code"><%= p.loc_picking||'SIN LOC FIJA' %></strong><small><%= p.zona_picking||'Picking dinámico' %></small><small>Objetivo: <%= p.stock_objetivo_pick %> <%= p.unidad_medida %></small></td><td><%= Number(p.peso_kg).toFixed(3) %> kg<small><%= Number(p.volumen_m3).toFixed(6) %> m³</small><small><%= p.control_lote?'Lote':'Sin lote' %> · <%= p.control_vencimiento?'FEFO':'Sin vencimiento' %></small></td><td><span class="badge <%= p.stock_critico?'text-bg-danger':'text-bg-success' %>"><%= p.stock_total %> <%= p.unidad_medida %></span><small>Mínimo global: <%= p.stock_minimo %></small></td><td><span class="status-pill <%= p.activo?'ok':'off' %>"><%= p.activo?'Activo':'Inactivo' %></span><small>Actualizado: <%= date(p.actualizado_en,true) %></small></td><td class="text-end"><% if(can('products.update')||can('products.update_logistics')){ %><a class="btn btn-sm btn-outline-warning" href="/productos/<%= p.id %>/editar"><%= can('products.update')?'Editar':'Configurar WMS' %></a><% } %></td></tr><% }) %></tbody></table></div></div>
