<% const locked=Boolean(role.sistema); const selected=role.permisos||[]; %>
<div class="page-head"><div><h1><%= title %></h1><p><%= locked?'Esta plantilla conserva la separación entre gobierno, planificación y ejecución.':'Configura el acceso mínimo para una responsabilidad concreta.' %></p></div><a class="btn btn-outline-light" href="/roles">Volver a roles</a></div>
<%- include('../partials/errors') %>
<form method="post" action="<%= role.id?'/roles/'+role.id+'?_method=PUT':'/roles' %>" class="role-editor" data-role-editor data-role-locked="<%= locked %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="role-editor-main"><section class="panel"><div class="section-top"><h2>Identidad del rol</h2><% if(locked){ %><span class="badge badge-warning">Protegido</span><% } %></div><div class="row g-3"><div class="col-md-6"><label class="form-label" for="roleName">Nombre del rol</label><input class="form-control" id="roleName" name="etiqueta" value="<%= role.etiqueta||'' %>" minlength="3" maxlength="70" required <%= locked?'readonly':'' %> placeholder="Coordinador de inventario"></div><div class="col-md-6"><label class="form-label" for="roleProfile">Interfaz de trabajo</label><select id="roleProfile" class="form-select" name="perfil" data-simple-select <%= locked?'disabled':'' %>><% if(role.perfil==='administrador_wms'){ %><option value="administrador_wms">Administración única</option><% } %><option value="jefe_operaciones" <%= role.perfil==='jefe_operaciones'?'selected':'' %>>Escritorio operativo</option><option value="operador_rf" <%= role.perfil==='operador_rf'?'selected':'' %>>Terminal móvil RF</option></select></div><div class="col-12"><label for="roleDescription" class="form-label">Responsabilidad</label><textarea class="form-control" name="descripcion" id="roleDescription" required minlength="12" maxlength="255" rows="3" <%= locked?'readonly':'' %> placeholder="Supervisar ubicaciones y consultar movimientos sin crear ni ejecutar tareas."><%= role.descripcion||'' %></textarea></div></div></section>
<section class="panel role-permissions"><div class="section-top"><div><h2>Permisos por recurso</h2><p class="field-help">Marcar una acción incluye los permisos de consulta que necesita.</p></div><button type="button" class="btn btn-outline-light" data-role-clear <%= locked?'disabled':'' %>>Limpiar</button></div><label class="visually-hidden" for="permissionSearch">Buscar permiso</label><input id="permissionSearch" type="search" class="form-control mb-3" placeholder="Buscar recurso o acción…" data-permission-search><% [...new Set(catalog.map(p=>p.group))].forEach(group=>{ const items=catalog.filter(p=>p.group===group); %><fieldset class="permission-group" data-permission-group><legend><%= group %></legend><div class="permission-grid"><% items.forEach(p=>{ %><label class="permission-choice" data-permission-choice data-profiles="<%= p.profiles.join(' ') %>"><input type="checkbox" name="permisos" value="<%= p.key %>" data-dependencies="<%= p.dependencies.join(' ') %>" <%= selected.includes(p.key)?'checked':'' %> <%= locked?'disabled':'' %>><span><strong><%= p.label %></strong><small><%= p.key %></small></span></label><% }) %></div></fieldset><% }) %><p data-permission-empty hidden class="empty-state">No hay permisos que coincidan con la búsqueda.</p></section></div>
<aside class="role-editor-summary panel"><span class="eyebrow">Acceso efectivo</span><h2><span data-permission-count><%= selected.length %></span> permisos</h2><p data-role-profile-summary></p><div data-permission-summary class="permission-summary-list"></div><div class="role-security-note"><svg class="icon"><use href="/icons.svg#i-shield"/></svg><p>Usuarios, roles, recuperaciones, compras y aprobación de ajustes están reservados al administrador único.</p></div><% if(!locked){ %><label class="form-switch-box"><input type="checkbox" name="activo" value="1" <%= role.activo?'checked':'' %>><span><strong>Rol activo</strong><small>Puede asignarse a usuarios.</small></span></label><button type="submit" class="btn btn-brand w-100 mt-3"><%= role.id?'Guardar cambios':'Crear rol' %></button><% } else { %><p class="field-help">Para otra responsabilidad, crea un rol personalizado; no alteres esta plantilla.</p><% } %><% if(history.length){ %><details class="mt-3"><summary>Últimos cambios</summary><% history.forEach(e=>{ %><p class="field-help"><%= e.actor||'Sistema' %> · <%= date(e.creado_en,true) %></p><% }) %></details><% } %></aside></form>
<script src="/js/roles.js" defer></script>
